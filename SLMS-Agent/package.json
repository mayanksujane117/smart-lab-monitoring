{
  "name": "slms-agent",
  "version": "1.0.0",
  "description": "Smart Lab Monitoring System Agent",
  "main": "main.js",
  "author": "Mayank",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "axios": "^1.17.0",
    "socket.io-client": "^4.8.3",
    "systeminformation": "^5.31.7"
  },
  "devDependencies": {
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.slms.agent",
    "productName": "SLMS Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SLMS Agent"
    }
  }
}